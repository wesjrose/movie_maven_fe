# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies and build output
node_modules
dist
dist-ssr

# Vite / TypeScript caches (also written under node_modules/.vite and node_modules/.tmp)
*.tsbuildinfo

# Test coverage (Vitest default reporter output)
coverage

# Env: Vite loads `.env`, `.env.[mode]`, `.env.local`, and `.env.[mode].local`.
# Shared defaults in `.env` are meant to be committed. Secrets and machine-specific
# values go in `*.local` files, which this pattern ignores.
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Custom Application Ignore
/api/*
.cursor/*
